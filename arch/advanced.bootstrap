pacstrap -K /mnt base linux linux-headers linux-firmware \
base-devel \
linux-lts linux-lts-headers \
amd-ucode \
sudo \
zram-generator \
btrfs-progs \
neovim vim nano \
git \
networkmanager \
grub efibootmgr \
man-db man-pages texinfo \
openssh \
curl wget \
bash-completion \
tmux \
htop \
jq yq \
tree \
fzf \
fastfetch

